.shell powershell

# Reload whkd configuration
# alt + o                 : taskkill /f /im whkd.exe && start /b whkd # if shell is cmd
alt + o                 : taskkill /f /im whkd.exe; Start-Process whkd -WindowStyle hidden # if shell is pwsh / powershell
alt + shift + o         : komorebic reload-configuration

lwin + q                      : glazewm command close
lwin + m                      : glazewm command close

# Focus windows
lwin + left                   : glazewm command focus --direction left
lwin + down                   : glazewm command focus --direction down
lwin + up                     : glazewm command focus --direction up
lwin + right                  : glazewm command focus --direction right

# Move windows
lwin + control + left         : glazewm command move --direction left
lwin + control + down         : glazewm command move --direction down
lwin + control + up           : glazewm command move --direction up
lwin + control + right        : glazewm command move --direction right

# Resize
lwin + shift + left           : glazewm command resize --width +2%
lwin + shift + right          : glazewm command resize --width -2%
lwin + shift + up             : glazewm command resize --height -2%
lwin + shift + down           : glazewm command resize --height +2%

# Manipulate windows
alt + v                       : glazewm command toggle-floating
lwin + return                 : glazewm command toggle-fullscreen

# Workspaces
lwin + 1                      : glazewm_helper.ps1 focus_workspace 0
lwin + 2                      : glazewm_helper.ps1 focus_workspace 1
lwin + 3                      : glazewm_helper.ps1 focus_workspace 2
lwin + 4                      : glazewm_helper.ps1 focus_workspace 3
lwin + 5                      : glazewm_helper.ps1 focus_workspace 4
lwin + 6                      : glazewm_helper.ps1 focus_workspace 5
lwin + 7                      : glazewm_helper.ps1 focus_workspace 6
lwin + 8                      : glazewm_helper.ps1 focus_workspace 7
lwin + 9                      : glazewm_helper.ps1 focus_workspace 8
lwin + 0                      : glazewm_helper.ps1 focus_workspace 9

# Move windows across workspaces
lwin + shift + 1              : glazewm_helper.ps1 move_active_window_to_workspace 0
lwin + shift + 2              : glazewm_helper.ps1 move_active_window_to_workspace 1
lwin + shift + 3              : glazewm_helper.ps1 move_active_window_to_workspace 2
lwin + shift + 4              : glazewm_helper.ps1 move_active_window_to_workspace 3
lwin + shift + 5              : glazewm_helper.ps1 move_active_window_to_workspace 4
lwin + shift + 6              : glazewm_helper.ps1 move_active_window_to_workspace 5
lwin + shift + 7              : glazewm_helper.ps1 move_active_window_to_workspace 6
lwin + shift + 8              : glazewm_helper.ps1 move_active_window_to_workspace 7
lwin + shift + 9              : glazewm_helper.ps1 move_active_window_to_workspace 8
lwin + shift + 0              : glazewm_helper.ps1 move_active_window_to_workspace 9
lwin + h                      : komorebic minimize

lwin + f : explorer.exe
lwin + b : C:\"Program Files"\Google\Chrome\Application\chrome.exe
lwin + t : wt
lwin + shift + t : powershell -Command "Start-Process 'wt.exe' -Verb RunAs"
lwin + tab : glazewm_helper.ps1 focus_workspace_relative 1
lwin + shift + tab : glazewm_helper.ps1 focus_workspace_relative -1
